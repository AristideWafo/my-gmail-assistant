GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GEMINI_API_KEY=your_gemini_api_key
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=your_typesafe_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
STARTUP_CHECKS=warn
POLL_INTERVAL_SECONDS=60
# Chat message once fetching mail has failed for this long, and again when it recovers; 0 disables
POLL_FAILURE_ALERT_MINUTES=10
SYNC_HISTORY=false
DB_PATH=data/assistant.db
# Daily verified copy of the database, one file per day; empty disables it
BACKUP_DIR=
BACKUP_KEEP=7
# Only one process may poll a bot token (Telegram answers 409 to a second poller)
TELEGRAM_INBOUND_ENABLED=false
# Required for inbound when TELEGRAM_CHAT_ID is a group/channel: comma-separated numeric user ids
# allowed to press buttons and reply (a private chat defaults to its own user)
TELEGRAM_ALLOWED_USER_IDS=
# Extra deterministic rules and VIP senders (see config/triage_rules.example.toml); empty = built-in rules only
TRIAGE_RULES_PATH=
# Feeds your Faux-Urgent/Faux-Spam verdicts to JEV as few-shot examples (sender domain and
# subject only; subjects are attacker-chosen text, keep off until verified)
JEV_FEW_SHOT_ENABLED=false
# Asks JEV whether a mail expects a reply; those that do get a Gmail draft and the label
# Assistant/A_repondre, urgent or not. Telegram alerts still depend on urgency alone
NEEDS_REPLY_ENABLED=false
NEEDS_REPLY_THRESHOLD=0.5
# off | shadow | on. shadow asks JEV three more yes/no questions (event you are expected at,
# planned outage or change, something to do before a date) and stores the answers, with no other
# effect; on also labels those mails Assistant/A_voir and keeps them out of the archive
ATTENTION_MODE=off
ATTENTION_THRESHOLD=0.5
# Offers to unsubscribe from senders whose mail is always archived (needs TELEGRAM_INBOUND_ENABLED)
UNSUBSCRIBE_PROPOSALS_ENABLED=false
UNSUBSCRIBE_MIN_ARCHIVED=5
# Implementation selectors (see README "Choosing / adding implementations")
MAIL_PROVIDER=gmail
CLASSIFIER=jev
LLM_PROVIDER=gemini
# Comma-separated, in delivery priority order
ALERT_CHANNELS=telegram,discord
CHAT_INBOX=telegram
STORE_BACKEND=sqlite
UNSUBSCRIBER=http
GRAFANA_ADMIN_PASSWORD=change_me
