GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GEMINI_API_KEY=your_gemini_api_key
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=your_typesafe_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
STARTUP_CHECKS=warn
# Docker only. Published image version to run (see the releases); pin it, and lower it to roll back
VERSION=latest
# Docker only. Address the ports 8000, 9090 and 3000 are published on; keep 127.0.0.1 unless a
# firewall protects the host, and then set GRAFANA_ADMIN_PASSWORD
BIND_ADDRESS=127.0.0.1
POLL_INTERVAL_SECONDS=60
# Chat message once fetching mail has failed for this long, and again when it recovers; 0 disables
POLL_FAILURE_ALERT_MINUTES=10
# Chat message when failures pile up (JEV fallbacks, skipped mails, Gemini errors, silent
# Telegram listener): MIN_EVENTS over the window. 0 minutes disables
HEALTH_ALERT_WINDOW_MINUTES=15
HEALTH_ALERT_MIN_EVENTS=3
# Estimated Gemini spend per day above which Gemini is no longer called; 0 = no cap
LLM_DAILY_BUDGET_USD=0
SYNC_HISTORY=false
DB_PATH=data/assistant.db
# Daily verified copy of the database, one file per day; empty disables it
BACKUP_DIR=
BACKUP_KEEP=7
# Only one process may poll a bot token (Telegram answers 409 to a second poller)
TELEGRAM_INBOUND_ENABLED=false
# Required for inbound when TELEGRAM_CHAT_ID is a group/channel: comma-separated numeric user ids
# allowed to press buttons and reply (a private chat defaults to its own user)
TELEGRAM_ALLOWED_USER_IDS=
# Extra deterministic rules and VIP senders (see config/triage_rules.example.toml); empty = built-in rules only
TRIAGE_RULES_PATH=
# Feeds your Faux-Urgent/Faux-Spam verdicts to JEV as few-shot examples (sender domain and
# subject only; subjects are attacker-chosen text, keep off until verified)
JEV_FEW_SHOT_ENABLED=false
# Asks JEV whether a mail expects a reply; those that do get a Gmail draft and the label
# Assistant/A_repondre, urgent or not. Telegram alerts still depend on urgency alone
NEEDS_REPLY_ENABLED=false
NEEDS_REPLY_THRESHOLD=0.5
# off | shadow | on. shadow asks JEV three more yes/no questions (event you are expected at,
# planned outage or change, something to do before a date) and stores the answers, with no other
# effect; on also labels those mails Assistant/A_voir and keeps them out of the archive
ATTENTION_MODE=off
ATTENTION_THRESHOLD=0.5
# Local hour (0-23) of the silent daily list of mails put forward; -1 disables. Needs ATTENTION_MODE=on
ATTENTION_LIST_HOUR=-1
# IANA time zone for everything scheduled at a local hour
TIMEZONE=Europe/Paris
# Unsolicited messages per local day (the daily list counts as one); urgent alerts are not counted
PROACTIVE_DAILY_CAP=6
# Local hours with no unsolicited message, e.g. 22-8 (may cross midnight); empty for none
QUIET_HOURS=
# off | shadow | on. shadow tracks the threads holding a mail you sent and who they wait for,
# from their headers only, with no message; on also offers follow-ups in Telegram, sent only
# when you press [Envoyer] (needs TELEGRAM_INBOUND_ENABLED)
FOLLOW_UP_MODE=off
# Weekdays without an answer before a follow-up is due
FOLLOW_UP_AFTER_DAYS=3
FOLLOW_UP_REFRESH_MINUTES=15
# Probability from which JEV's "does my mail wait for something" counts as yes
FOLLOW_UP_THRESHOLD=0.5
# Local hour from which follow-ups are offered on weekdays, and at most how many a day
FOLLOW_UP_HOUR=10
FOLLOW_UP_DAILY_MAX=3
FOLLOW_UP_MAX_THREADS=50
# Offers to unsubscribe from senders whose mail is always archived (needs TELEGRAM_INBOUND_ENABLED)
UNSUBSCRIBE_PROPOSALS_ENABLED=false
UNSUBSCRIBE_MIN_ARCHIVED=5
# Implementation selectors (see README "Choosing / adding implementations")
MAIL_PROVIDER=gmail
CLASSIFIER=jev
LLM_PROVIDER=gemini
# The model driving the agent's tool loop (uses GEMINI_API_KEY); nothing calls it yet
AGENT_PROVIDER=gemini
AGENT_MODEL=gemini-2.5-flash
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS=60000
# What the agent may spend per local day, apart from LLM_DAILY_BUDGET_USD (0 = no cost cap)
AGENT_DAILY_BUDGET_USD=0
AGENT_DAILY_MAX_RUNS=100
# Comma-separated, in delivery priority order
ALERT_CHANNELS=telegram,discord
CHAT_INBOX=telegram
STORE_BACKEND=sqlite
UNSUBSCRIBER=http
GRAFANA_ADMIN_PASSWORD=change_me
