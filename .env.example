GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GEMINI_API_KEY=your_gemini_api_key
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=your_typesafe_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
STARTUP_CHECKS=warn
POLL_INTERVAL_SECONDS=60
SYNC_HISTORY=false
DB_PATH=data/assistant.db
# Daily verified copy of the database, one file per day; empty disables it
BACKUP_DIR=
BACKUP_KEEP=7
# Only one process may poll a bot token (Telegram answers 409 to a second poller)
TELEGRAM_INBOUND_ENABLED=false
# Required for inbound when TELEGRAM_CHAT_ID is a group/channel: comma-separated numeric user ids
# allowed to press buttons and reply (a private chat defaults to its own user)
TELEGRAM_ALLOWED_USER_IDS=
# Feeds your Faux-Urgent/Faux-Spam verdicts to JEV as few-shot examples (sender domain and
# subject only; subjects are attacker-chosen text, keep off until verified)
JEV_FEW_SHOT_ENABLED=false
# Implementation selectors (see README "Choosing / adding implementations")
MAIL_PROVIDER=gmail
CLASSIFIER=jev
LLM_PROVIDER=gemini
# Comma-separated, in delivery priority order
ALERT_CHANNELS=telegram,discord
CHAT_INBOX=telegram
STORE_BACKEND=sqlite
GRAFANA_ADMIN_PASSWORD=change_me
