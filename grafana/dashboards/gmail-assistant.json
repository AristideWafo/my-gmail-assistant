{
  "title": "Gmail Assistant",
  "uid": "gmail-assistant",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Processed emails (rate, by urgency/category)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (urgency, category) (rate(processed_emails_total[5m]))",
          "legendFormat": "{{urgency}}/{{category}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Triage latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(triage_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "JEV fallback rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(jev_fallback_total[5m])", "legendFormat": "fallback/s" }]
    },
    {
      "id": 4,
      "title": "LLM tokens (rate, by kind/type)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (kind, token_type) (rate(llm_tokens_total[5m]))",
          "legendFormat": "{{kind}}/{{token_type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "LLM cost per hour (USD, by kind)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (kind) (rate(llm_cost_usd_total[1h]) * 3600)",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
